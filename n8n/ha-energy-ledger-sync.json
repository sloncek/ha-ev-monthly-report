    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const allowed = ['month','status','odometer_km','monthly_distance_km','home_kwh','reimbursement_rate','home_reimbursement_eur','public_gross_eur','other_gross_eur','eligible_expenses_eur','monthly_eligible_eur','opening_balance_eur','requested_eur','reported_eur','closing_balance_eur','pending_home_delta_eur','pending_delta_verified','energy_complete','month_complete','source_quality','ready_to_report','public_energy_complete','current_home_kwh','current_source_quality','reported_at'];\nconst envelope = $input.first()?.json;\nif (!envelope || envelope.schema_version !== 1 || !Array.isArray(envelope.months)) throw new Error('Unsupported Energy Ledger export schema');\nreturn envelope.months.map((month) => {\n  if (typeof month.month !== 'string' || !/^\\d{4}-(0[1-9]|1[0-2])$/.test(month.month)) throw new Error('Invalid month in export');\n  const row = {};\n  for (const key of allowed) row[key] = month[key] ?? '';\n  return { json: row };\n});"
      },
